{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Altinn/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^schemas/regenerate\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\nOPERATOR_VERSION\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    }
  ]
}
