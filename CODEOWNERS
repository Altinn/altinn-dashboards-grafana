# Default owners; the last matching pattern determines ownership.
*       @Altinn/team-platform

# Per-product ownership, with datasource configuration assigned to platform below.
# Add one line per product as it is onboarded. Keep the trailing slash so the whole
# folder (dashboards/, alerting/, …) is covered recursively — a `products/<name>/*`
# glob would not match nested subdirectories.
/products/authorization/   @Altinn/team-access-management
/products/dialogporten/    @Altinn/team-dialogporten-infra
/products/infoportal/      @Altinn/team-portal
/products/ki-norge/        @Altinn/team-ai-lab

# Platform review for connections in the shared Grafana instance.
/products/*/datasources/   @Altinn/team-platform
