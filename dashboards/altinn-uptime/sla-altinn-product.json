  "templating": {
    "list": [
      {
        "allValue": "[^./]+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "admin-prod-obs-amw"
        },
        "definition": "label_values(altinn:probe_success_health_check:max_by_instance{instance=~\"^[^./]+[.](tt02[.])?altinn[.]no(/[^/]+)?$\"}, instance)",
        "includeAll": true,
        "label": "Product",
        "multi": true,
        "name": "product",
        "options": [],
        "query": {
          "query": "label_values(altinn:probe_success_health_check:max_by_instance{instance=~\"^[^./]+[.](tt02[.])?altinn[.]no(/[^/]+)?$\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "/(?:^|\\/)([^.\\/]+)(?:[.](?:tt02[.])?altinn[.]no)?$/",
        "regexApplyTo": "value",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
