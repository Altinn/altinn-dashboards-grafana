        },
        "showHeader": true
      },
      "targets": [
        {
          "azureResourceGraph": {
            "query": "resources\n| where type =~ 'microsoft.containerservice/managedclusters'\n| where '${cluster}' == '' or name contains '${cluster}'\n| join kind=leftouter (resourcecontainers | where type =~ 'microsoft.resources/subscriptions' | project subscriptionId, Subscription=name) on subscriptionId\n| extend cp = tostring(properties.currentKubernetesVersion)\n| mv-expand pool = properties.agentPoolProfiles\n| extend State=tostring(pool.provisioningState), Power=tostring(pool.powerState.code), Version=tostring(pool.currentOrchestratorVersion)\n| extend Behind = iff(Version != cp, 'yes', '')\n| extend ok = iff(State == 'Succeeded' and Power == 'Running', 1, 0)\n| order by ok asc, Behind desc, name asc, tostring(pool.name) asc\n| project Cluster=name, Subscription, Pool=tostring(pool.name), Mode=tostring(pool.mode), State, Power, Version, ControlPlane=cp, Behind, NodeImage=tostring(pool.nodeImageVersion), Count=toint(pool['count']), Min=toint(pool.minCount), Max=toint(pool.maxCount), Autoscale=tobool(pool.enableAutoScaling), VmSize=tostring(pool.vmSize), OS=tostring(pool.osSKU), MaxSurge=tostring(pool.upgradeSettings.maxSurge), MaxUnavailable=tostring(pool.upgradeSettings.maxUnavailable), UndrainableNodes=tostring(pool.upgradeSettings.undrainableNodeBehavior), Zones=strcat_array(pool.availabilityZones, ','), id",
            "resultFormat": "table"
