          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B",
          "expr": "(sum by (\"altinn.service_owner\", \"altinn.environment\") (label_replace(max by (\"altinn.service_owner\", \"deployment.environment.name\", \"altinn.operator.app.state\") ({\"altinn.operator.app.count\", \"service.name\"=\"operator\", \"altinn.service_owner\"!~\"$exclude\"}), \"altinn.environment\", \"$1\", \"deployment.environment.name\", \"(.*)\"))) and on (\"altinn.service_owner\", \"altinn.environment\") ((max by (\"altinn.service_owner\", \"altinn.environment\") ({\"altinn.designer.deployed_app.count\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\"})) - on (\"altinn.service_owner\", \"altinn.environment\") (sum by (\"altinn.service_owner\", \"altinn.environment\") (label_replace(max by (\"altinn.service_owner\", \"deployment.environment.name\", \"altinn.operator.app.state\") ({\"altinn.operator.app.count\", \"service.name\"=\"operator\", \"altinn.service_owner\"!~\"$exclude\"}), \"altinn.environment\", \"$1\", \"deployment.environment.name\", \"(.*)\"))) != 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
