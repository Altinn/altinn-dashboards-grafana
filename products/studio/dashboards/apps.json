{
  "uid": "altinn-studio-apps",
  "title": "Altinn Studio — Apps",
  "description": "The service owners' apps: how many there are, how many are deployed to and running in each environment, and how many are created and deployed. Designer counts the apps in Gitea's database and the deployed apps in its deployment history every 15 minutes, and counts creations and deployment outcomes as they happen (altinn.designer.app.*, from Designer in the selected Studio environment). Each service owner cluster's operator counts the apps running there (altinn.operator.app.count). All from altinn-studio-metrics, which isn't sampled and keeps 90 days. The counts are right from the first report, while the counters and the trend lines only reach back to when the services started reporting them. Designer may run several replicas that report the same counts, so the queries take their maximum. Leave out service owners, such as the test organization ttd, with the regex in Leave out.",
  "tags": [
    "altinn-studio",
    "apps"
  ],
  "editable": false,
  "schemaVersion": 42,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "timepicker": {
    "refresh_intervals": [
      "15m",
      "1h"
    ]
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "altinn-studio"
      ],
      "targetBlank": false,
      "title": "Studio dashboards",
      "type": "dashboards"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "studio",
        "label": "Studio environment",
        "description": "Studio environment whose Designer reports the apps (deployment.environment.name). Only prod deploys to production.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "altinn-studio-metrics"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({\"altinn.designer.app.count\", \"service.name\"=\"studio-designer\"}, \"deployment.environment.name\")",
          "refId": "studio"
        },
        "definition": "label_values({\"altinn.designer.app.count\", \"service.name\"=\"studio-designer\"}, \"deployment.environment.name\")",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        },
        "sort": 1
      },
      {
        "name": "exclude",
        "label": "Leave out",
        "description": "Service owners to leave out, as a regex on altinn.service_owner, such as ttd|digdir. Empty leaves out none.",
        "type": "textbox",
        "query": "ttd",
        "current": {
          "selected": false,
          "text": "ttd",
          "value": "ttd"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Apps",
      "description": "App repositories in the service owners' organizations in Studio's Gitea, private ones included. Shared repositories (datamodels, content, resources) and apps in developers' own accounts don't count. Designer counts them in Gitea's database every 15 minutes (altinn.designer.app.count).",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum(max by (\"altinn.service_owner\") ({\"altinn.designer.app.count\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 32
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deployed to prod",
      "description": "Apps whose latest successful deployment to production is a deploy rather than a decommission, from Designer's deployment history (altinn.designer.deployed_app.count).",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum(max by (\"altinn.service_owner\") ({\"altinn.designer.deployed_app.count\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\", \"altinn.environment\"=\"prod\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 32
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running in prod",
      "description": "Apps in the production clusters whose Deployment has a ready replica, as each cluster's operator sees it (altinn.operator.app.count). Only clusters whose operator reports the metric count.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum(max by (\"altinn.service_owner\") ({\"altinn.operator.app.count\", \"service.name\"=\"operator\", \"altinn.service_owner\"!~\"$exclude\", \"deployment.environment.name\"=\"prod\", \"altinn.operator.app.state\"=\"running\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 32
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Not running in prod",
      "description": "Apps in the production clusters without a ready replica: the app fails to start, or is being deployed for the first time. The inactivity scaler doesn't run in production, so none are scaled down on purpose.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum(max by (\"altinn.service_owner\") ({\"altinn.operator.app.count\", \"service.name\"=\"operator\", \"altinn.service_owner\"!~\"$exclude\", \"deployment.environment.name\"=\"prod\", \"altinn.operator.app.state\"=\"not_running\"})) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 32
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "New apps",
      "description": "Apps created in Studio in the time range, from a template or as a copy (altinn.designer.app.creations). Counted from when Designer started reporting it.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
