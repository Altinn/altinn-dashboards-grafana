            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B",
          "expr": "sum(max by (\"altinn.service_owner\") ({\"altinn.designer.deployed_app.count\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\", \"altinn.environment\"=\"tt02\"}))",
          "legendFormat": "Deployed to tt02",
