          "refId": "A",
          "expr": "sum (increase_pure({\"altinn.designer.app.creations\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\"}[$__range])) or vector(0)",
          "legendFormat": "",
