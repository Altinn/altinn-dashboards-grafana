            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum by (\"error.type\") (increase_pure({\"altinn.designer.app.deployments\", \"service.name\"=\"studio-designer\", \"deployment.environment.name\"=\"$studio\", \"altinn.service_owner\"!~\"$exclude\", \"error.type\"!=\"\"}[$__interval]))",
