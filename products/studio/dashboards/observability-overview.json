    {
      "type": "timeseries",
      "title": "VMSingle free disk",
      "description": "Free space on each VMSingle volume (512 GiB) against its floor, -storage.minFreeDiskSpaceBytes (100 GiB): below the floor VMSingle stops accepting writes and the agents queue. Metrics are kept 90 days and old data is not dropped to make room.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "vm_free_disk_space_bytes{job=\"vmsingle\"}",
          "legendFormat": "copy {{copy}} free",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B",
          "expr": "max(vm_free_disk_space_limit_bytes{job=\"vmsingle\"})",
          "legendFormat": "floor",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "floor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": []
    },
    {
      "type": "stat",
      "title": "Days until floor",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 4,
        "h": 8
      },
      "description": "Days until each VMSingle copy reaches its free space floor if free space keeps shrinking at the rate of the last 24 hours. Empty when it is not shrinking.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "(vm_free_disk_space_bytes{job=\"vmsingle\"} - vm_free_disk_space_limit_bytes{job=\"vmsingle\"}) / (-deriv(vm_free_disk_space_bytes{job=\"vmsingle\"}[1d]) > 0) / 86400",
          "legendFormat": "copy {{copy}}",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "noValue": "Not filling",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
