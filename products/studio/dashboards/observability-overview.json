    {
      "type": "stat",
      "title": "Scrape targets",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "description": "Targets of vmagent-self that answered (up) and did not (down) at the last scrape: two copies of each storage, two replicas of each agent, the operator and vmagent-self. With no data at all, vmagent-self or the metrics storage is down.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "sum(up{job=~\"vmsingle|vlsingle|vtsingle|vmagent|vlagent|vtagent|operator|vmagent-self\"})",
          "legendFormat": "Up",
          "range": false,
          "editorMode": "code",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B",
          "expr": "count(up{job=~\"vmsingle|vlsingle|vtsingle|vmagent|vlagent|vtagent|operator|vmagent-self\"} == 0) or vector(0)",
          "legendFormat": "Down",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "links": []
    },
    {
      "type": "state-timeline",
      "title": "Scrape targets over time",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "description": "up per scrape target, every 30 s. The storage targets are the two copies (…-a, …-b) of each signal; the agents are scraped per replica.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "label_replace(up{job=~\"vmsingle|vlsingle|vtsingle|vmagent|vlagent|vtagent|operator|vmagent-self\"}, \"instance\", \"vmagent-self\", \"job\", \"vmagent-self\")",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
