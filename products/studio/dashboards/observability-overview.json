    {
      "type": "timeseries",
      "title": "Restarts",
      "description": "Process restarts per target: process_start_time_seconds is later than its last value in the hour before, so a restart after downtime counts too. A storage copy or agent replica that restarts repeatedly is crash-looping or being OOM-killed; see Memory against the limit below.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "label_replace(count by (job, instance) (process_start_time_seconds{job=~\"vmsingle|vlsingle|vtsingle|vmagent|vlagent|vtagent|operator|vmagent-self\"} > last_over_time(process_start_time_seconds{job=~\"vmsingle|vlsingle|vtsingle|vmagent|vlagent|vtagent|operator|vmagent-self\"}[1h] offset $__interval)), \"instance\", \"vmagent-self\", \"job\", \"vmagent-self\")",
          "legendFormat": "{{instance}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "noValue": "No restarts"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [],
      "interval": "1m"
    },
