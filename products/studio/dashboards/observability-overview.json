    {
      "type": "timeseries",
      "title": "Agent queue per copy",
      "description": "Data each agent holds for a storage copy it cannot write to yet (in memory and in its on-disk queue), for the replica holding the most. Each replica queues up to 20 GiB per copy (maxDiskUsagePerURL) on its 50 GiB volume and then drops the oldest data. Copy a is the first remote-write URL (1:secret-url), copy b the second.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "max by (job, copy) (label_replace(label_replace(max by (job, url) (vmagent_remotewrite_pending_data_bytes{job=\"vmagent\"}), \"copy\", \"a\", \"url\", \"1:.*\"), \"copy\", \"b\", \"url\", \"2:.*\") or label_replace(label_replace(max by (job, url) (vlagent_remotewrite_pending_data_bytes{job=\"vlagent\"}), \"copy\", \"a\", \"url\", \"1:.*\"), \"copy\", \"b\", \"url\", \"2:.*\") or label_replace(label_replace(max by (job, url) (vtagent_remotewrite_pending_data_bytes{job=\"vtagent\"}), \"copy\", \"a\", \"url\", \"1:.*\"), \"copy\", \"b\", \"url\", \"2:.*\"))",
          "legendFormat": "{{job}} → copy {{copy}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 21474836480
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 21474836480
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Data dropped by agents",
      "description": "Blocks the agents dropped, per storage copy: queue overflow, when a copy has been unreachable long enough to fill its 20 GiB queue (vm_persistentqueue_blocks_dropped_total; vm_persistentqueue_bytes_dropped_total has the bytes), and blocks a copy rejected for good (*_remotewrite_packets_dropped_total). Should be zero: anything here is data missing from that copy.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A",
          "expr": "label_replace(label_replace(sum by (job, path) (increase(vm_persistentqueue_blocks_dropped_total{job=~\"vmagent|vlagent|vtagent\"}[$__interval])), \"copy\", \"a\", \"path\", \".*/1_[^/]*\"), \"copy\", \"b\", \"path\", \".*/2_[^/]*\")",
          "legendFormat": "{{job}} → copy {{copy}} queue overflow",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B",
          "expr": "label_replace(label_replace(sum by (job, url) (increase({__name__=~\"(vmagent|vlagent|vtagent)_remotewrite_packets_dropped_total\", job=~\"vmagent|vlagent|vtagent\"}[$__interval])), \"copy\", \"a\", \"url\", \"1:.*\"), \"copy\", \"b\", \"url\", \"2:.*\")",
          "legendFormat": "{{job}} → copy {{copy}} rejected",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [],
      "interval": "1m"
