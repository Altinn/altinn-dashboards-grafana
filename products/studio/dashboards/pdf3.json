{
  "uid": "altinn-studio-pdf3",
  "title": "Altinn Studio — PDF3",
  "description": "PDF generation in pdf3 (proxy and workers) in the runtime environments. Requests, latency, status codes and the outcome of each generation come from the services' HTTP server metrics, where the worker sets error.type on failed generations; failed and slow requests from traces, which tail sampling always keeps, with example traces and links from the metric panels to the matching traces. The Request URLs row shows what the requested URLs point to, per cluster, which in the runtime clusters is per service owner. Datasource UIDs are pinned, matching the other Altinn Studio dashboards.",
  "tags": [
    "altinn-studio",
    "pdf3"
  ],
  "editable": false,
  "schemaVersion": 42,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "altinn-studio-metrics"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\"}, \"deployment.environment.name\")",
          "refId": "env"
        },
        "definition": "label_values({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\"}, \"deployment.environment.name\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "description": "Filters the Request URLs panels only. In the runtime clusters, a cluster is a service owner.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "altinn-studio-metrics"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"deployment.environment.name\"=~\"$env\"}, \"k8s.cluster.name\")",
          "refId": "cluster"
        },
        "definition": "label_values({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"deployment.environment.name\"=~\"$env\"}, \"k8s.cluster.name\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests (proxy, POST /pdf)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second",
      "description": "PDF requests the proxy received per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Server errors",
      "description": "Share of PDF requests that failed in pdf3 (5xx). Invalid requests from apps (4xx) are shown under Proxy responses by status code.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile of the proxy's response time, including the retries when every worker is busy.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate({\"http.server.request.duration_bucket\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Worker rejections per second",
      "description": "Requests a worker turned away because it was already generating a PDF (429). The proxy retries them on another worker; a sustained rate means pdf3 needs more workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-worker\", \"http.route\"=\"/generate\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=\"429\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Traffic and latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Proxy responses by status code",
      "description": "PDF requests per second by the status the proxy returned.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (\"http.response.status_code\") (rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{http.response.status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Traces with this status",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22altinn-studio-traces%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22altinn-studio-traces%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22pdf3-proxy%5C%22%20%26%26%20span.http.route%3D%5C%22%2Fpdf%5C%22%20%26%26%20span.http.response.status_code%3D${__field.labels[\"http.response.status_code\"]}%20%26%26%20resource.deployment.environment.name%3D~%5C%22${env:regex}%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Proxy latency",
      "description": "Response time of successful PDF requests at the proxy, including retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate({\"http.server.request.duration_bucket\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=~\"2..\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate({\"http.server.request.duration_bucket\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=~\"2..\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate({\"http.server.request.duration_bucket\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=~\"2..\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Slow traces (over 10 s)",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22altinn-studio-traces%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22altinn-studio-traces%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22pdf3-proxy%5C%22%20%26%26%20span.http.route%3D%5C%22%2Fpdf%5C%22%20%26%26%20duration%20%3E%2010s%20%26%26%20resource.deployment.environment.name%3D~%5C%22${env:regex}%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "row",
      "title": "Request URLs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Request URLs by kind",
      "description": "PDF requests per second by what the requested URL points to. standard is the app's normal PDF page; app_other is another page on the app's own host and under /{org}/{app}/; other is anything else (another host, scheme or path, or an invalid URL). The proxy records the kind as altinn.pdf.url_kind from Altinn/altinn-studio#21115 onwards, and only where it knows the environment's app hostname (at22, at23, at24, yt01, tt02, prod). unknown is requests without the attribute: from proxy versions before it, and requests rejected before the URL is read (wrong method or content type, too large, invalid JSON). Filtered by the Cluster variable. Each runtime cluster belongs to one service owner, so a cluster (k8s.cluster.name) is a service owner there; after pdf3 moves to the shared DIS core cluster there is one cluster per environment, and this no longer holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "label_replace(sum by (\"altinn.pdf.url_kind\") (rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\"}[$__rate_interval])), \"altinn.pdf.url_kind\", \"unknown\", \"altinn.pdf.url_kind\", \"\")",
          "legendFormat": "{{altinn.pdf.url_kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "standard"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app_other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Clusters sending other URLs",
      "description": "Per cluster, the PDF requests over the dashboard's time range whose URL is not the app's normal PDF page: app_other and other, their sum (non-standard), and their share of the requests that have a kind. Clusters that only requested standard pages are not listed. standard is the app's normal PDF page; app_other is another page on the app's own host and under /{org}/{app}/; other is anything else (another host, scheme or path, or an invalid URL). The proxy records the kind as altinn.pdf.url_kind from Altinn/altinn-studio#21115 onwards, and only where it knows the environment's app hostname (at22, at23, at24, yt01, tt02, prod). Requests without the attribute are left out, so pick a time range after #21115 reached the environment. Filtered by the Cluster variable. Each runtime cluster belongs to one service owner, so a cluster (k8s.cluster.name) is a service owner there; after pdf3 moves to the shared DIS core cluster there is one cluster per environment, and this no longer holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "sum by (\"k8s.cluster.name\") (increase({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\", \"altinn.pdf.url_kind\"=\"app_other\"}[$__range])) > 0",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (\"k8s.cluster.name\") (increase({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\", \"altinn.pdf.url_kind\"=\"other\"}[$__range])) > 0",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "B"
        },
        {
          "expr": "sum by (\"k8s.cluster.name\") (increase({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\", \"altinn.pdf.url_kind\"=~\"app_other|other\"}[$__range])) > 0",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "C"
        },
        {
          "expr": "(sum by (\"k8s.cluster.name\") (increase({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\", \"altinn.pdf.url_kind\"=~\"app_other|other\"}[$__range])) > 0) / sum by (\"k8s.cluster.name\") (increase({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-proxy\", \"http.route\"=\"/pdf\", \"deployment.environment.name\"=~\"$env\", \"k8s.cluster.name\"=~\"$cluster\", \"altinn.pdf.url_kind\"!=\"\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "altinn-studio-metrics"
          },
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "k8s.cluster.name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "k8s.cluster.name": "Cluster",
              "Value #A": "app_other",
              "Value #B": "other",
              "Value #C": "Non-standard",
              "Value #D": "Non-standard share"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Non-standard share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Non-standard",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Workers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Generations by outcome",
      "description": "PDF generations per second in the workers, by outcome: success; failed, by the reason the worker gives as error.type on its 5xx responses (timeout, element_not_ready, client_dropped, …); queue full, a busy worker's 429, which the proxy retries on another; and invalid requests, the other 4xx, by status code. From the worker's HTTP server metrics, so unaffected by trace sampling.",
      "datasource": {
        "type": "prometheus",
        "uid": "altinn-studio-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (\"http.response.status_code\") (rate({\"http.server.request.duration_count\", \"service.name\"=\"pdf3-worker\", \"http.route\"=\"/generate\", \"deployment.environment.name\"=~\"$env\", \"http.response.status_code\"=~\"2..\"}[$__rate_interval]))",
          "legendFormat": "success",
          "datasource": {
